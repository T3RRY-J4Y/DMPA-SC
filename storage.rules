rules_version = '2';

// Resource files and thumbnails are public. Only admins can upload, replace
// or delete them, from the admin panel (admin.html).
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /resources/{file} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || request.resource.size < 50 * 1024 * 1024);
    }

    match /thumbs/{file} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null
        || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
